<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="@color/cinema_surface_variant"
    app:shimmer_duration="1200"
    app:shimmer_highlight_color="@color/cinema_surface_highlight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="238dp"
                    android:background="@drawable/bg_review_placeholder" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/cinema_surface_variant" />

                <View
                    android:layout_width="52dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="7dp"
                    android:background="@color/cinema_surface_variant" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="238dp"
                    android:background="@drawable/bg_review_placeholder" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/cinema_surface_variant" />

                <View
                    android:layout_width="52dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="7dp"
                    android:background="@color/cinema_surface_variant" />

            </LinearLayout>

    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
