<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.detail.DetailActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/img_movie"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_image_placeholder"
                    android:contentDescription="@string/movie_image"
                    android:scaleType="centerCrop" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/loading_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shimmer_auto_start="true"
                    app:shimmer_base_color="@color/cinema_surface_variant"
                    app:shimmer_duration="1200"
                    app:shimmer_highlight_color="@color/cinema_surface_highlight">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/cinema_surface_variant" />

                </com.facebook.shimmer.ShimmerFrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_hero_gradient" />

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_detail_icon_button"
                    android:contentDescription="@string/back"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/cinema_text_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_share"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_detail_icon_button"
                        android:contentDescription="@string/share"
                        android:padding="12dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/cinema_text_primary" />

                    <ImageButton
                        android:id="@+id/fab_favorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_detail_icon_button"
                        android:contentDescription="@string/add_to_favorites"
                        android:padding="12dp"
                        android:src="@drawable/ic_love"
                        app:tint="@color/cinema_text_primary" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/cinema_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="Resident Evil" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rating_chip"
                        android:textColor="@color/cinema_on_gold"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="★ 7.3" />

                    <TextView
                        android:id="@+id/tv_release"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_metadata_chip"
                        android:textColor="@color/cinema_text_secondary"
                        android:textSize="13sp"
                        tools:text="16 Sep 2026" />

                    <TextView
                        android:id="@+id/tv_vote_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_metadata_chip"
                        android:textColor="@color/cinema_text_secondary"
                        android:textSize="13sp"
                        tools:text="1.2K votes" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_overview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/overview_title"
                    android:textColor="@color/cinema_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="5"
                    android:textColor="@color/cinema_text_secondary"
                    android:textSize="16sp"
                    tools:text="A movie overview that explains the story with enough content to demonstrate the expandable description behavior." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_overview_toggle"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:minHeight="40dp"
                    android:text="@string/read_more"
                    android:textAllCaps="false"
                    android:textColor="@color/cinema_gold"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_similar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/title_similar"
                    android:textColor="@color/cinema_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/loading_similar"
                    layout="@layout/view_loading_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_movie_playing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    tools:listitem="@layout/item_movie" />

                <include
                    android:id="@+id/state_similar"
                    layout="@layout/view_section_state"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_review"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/title_review"
                    android:textColor="@color/cinema_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/loading_review"
                    layout="@layout/view_loading_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_movie_review"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    tools:listitem="@layout/item_review" />

                <include
                    android:id="@+id/state_review"
                    layout="@layout/view_section_state"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/state_detail"
        layout="@layout/view_section_state"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
