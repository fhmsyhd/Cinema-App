<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_marginHorizontal="16dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="@color/cinema_surface_variant"
    app:shimmer_duration="1200"
    app:shimmer_highlight_color="@color/cinema_surface_highlight">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/cinema_surface_variant"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cinema_surface_variant" />

    </com.google.android.material.card.MaterialCardView>

</com.facebook.shimmer.ShimmerFrameLayout>
