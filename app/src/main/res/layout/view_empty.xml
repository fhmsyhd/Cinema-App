<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="40dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="84dp"
        android:layout_height="84dp"
        app:cardBackgroundColor="@color/cinema_surface"
        app:cardCornerRadius="42dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/cinema_surface_variant"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="24dp"
            android:src="@drawable/ic_love"
            app:tint="@color/cinema_gold" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/no_favorites_title"
        android:textColor="@color/cinema_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_empty_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/no_favorites_message"
        android:textColor="@color/cinema_text_secondary"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_browse_movies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/browse_movies"
        android:textAllCaps="false"
        android:textColor="@color/cinema_on_gold"
        app:backgroundTint="@color/cinema_gold"
        app:cornerRadius="24dp" />

</LinearLayout>
